# {{ ansible_managed }}
[Unit]
Description=run {{ systemd_timer_name | regex_replace('-', ' ') }}

[Timer]
{% if systemd_timer_on_active_sec is defined %}
OnActiveSec={{ systemd_timer_on_active_sec }}
{% endif %}
{% if systemd_timer_on_boot_sec is defined %}
OnBootSec={{ systemd_timer_on_boot_sec }}
{% endif %}
{% if systemd_timer_on_calendar is defined %}
OnCalendar={{ systemd_timer_on_calendar }}
{% endif %}
{% if systemd_timer_on_startup_sec is defined %}
OnStartupSec={{ systemd_timer_on_startup_sec }}
{% endif %}
{% if systemd_timer_on_unit_active_sec is defined %}
OnUnitActiveSec={{ systemd_timer_on_unit_active_sec }}
{% endif %}
{% if systemd_timer_on_unit_inactive_sec is defined %}
OnUnitInactiveSec={{ systemd_timer_on_unit_inactive_sec }}
{% endif %}

[Install]
WantedBy=timers.target
